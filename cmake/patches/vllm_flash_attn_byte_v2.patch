+                "raw K/V shared alias requires explicit split-K");
+    TORCH_CHECK(params.d == Kernel_traits::kHeadDim,
+                "raw K/V shared alias requires exact head dimension");
+    TORCH_CHECK(params.knew_ptr == nullptr,
+                "raw K/V shared alias does not support KV append");
