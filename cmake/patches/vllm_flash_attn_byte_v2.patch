+        (params.b * params.h * params.seqlen_q + kBlockM - 1) / kBlockM);
+    if (params.num_splits <= 2) {
+        flash_fwd_splitkv_combine_kernel<Kernel_traits, kBlockM, 1, true>
+            <<<grid_combine, Kernel_traits::kNThreads, 0, stream>>>(params);
+    } else if (params.num_splits <= 4) {
+        flash_fwd_splitkv_combine_kernel<Kernel_traits, kBlockM, 2, true>
+            <<<grid_combine, Kernel_traits::kNThreads, 0, stream>>>(params);
