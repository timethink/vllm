+static std::vector<at::Tensor>
+mha_byte_v2_varlen_fwd_impl(
+        at::Tensor &q,
+        const at::Tensor &byte_v2_kv_cache,
+        const at::Tensor *byte_v2_raw_staging,
+        const at::Tensor *byte_v2_page_to_raw_slot,
+        std::optional<at::Tensor> &byte_v2_page_unsafe_flags_,
+        std::optional<at::Tensor> &out_,
+        const at::Tensor &cu_seqlens_q,
+        const at::Tensor &cu_seqlens_k,
+        std::optional<at::Tensor> &seqused_k,
+        std::optional<const at::Tensor> &leftpad_k_,
+        std::optional<at::Tensor> &block_table_,
+        std::optional<at::Tensor> &alibi_slopes_,
+        int max_seqlen_q,
+        const int max_seqlen_k,
+        const float p_dropout,
+        const float softmax_scale,
+        const bool zero_tensors,
+        bool is_causal,
+        int window_size_left,
+        int window_size_right,
+        const float softcap,
+        const bool return_softmax,
+        int num_splits,
+        std::optional<at::Generator> gen_) {
+    constexpr int kByteV2PageBlockSize = 16;
+    constexpr int kByteV2NumQueryHeads = 32;
+    constexpr int kByteV2NumKvHeads = 8;
+    constexpr int kByteV2HeadDim = 128;
+    constexpr int kByteV2PageSizeBytes = 52096;
+    constexpr int kByteV2RawSlotSizeBytes = 65536;
+
+    TORCH_CHECK((byte_v2_raw_staging == nullptr) ==
+                    (byte_v2_page_to_raw_slot == nullptr),
+                "ByteV2 FA2 raw staging/map mismatch");
+
+    CHECK_DEVICE(q);
+    CHECK_DEVICE(byte_v2_kv_cache);
+    TORCH_CHECK(q.device() == byte_v2_kv_cache.device(),
+                "query and ByteV2 KV cache must be on the same device");
+    TORCH_CHECK(q.dtype() == torch::kBFloat16,
+                "ByteV2 FA2 only supports BF16 query");
+    TORCH_CHECK(q.dim() == 3 && q.size(1) == kByteV2NumQueryHeads &&
+                    q.size(2) == kByteV2HeadDim,
+                "ByteV2 FA2 query must have shape (total_q, 32, 128)");
+    TORCH_CHECK(q.size(0) > 0 && q.stride(-1) == 1,
+                "ByteV2 FA2 query must be non-empty with contiguous head dimension");
+    TORCH_CHECK(byte_v2_kv_cache.dtype() == torch::kUInt8,
+                "ByteV2 KV cache must have dtype uint8");
+    TORCH_CHECK(byte_v2_kv_cache.dim() == 2,
+                "ByteV2 KV cache must have shape (num_pages, page_size_bytes)");
+    TORCH_CHECK(byte_v2_kv_cache.size(1) == kByteV2PageSizeBytes,
+                "ByteV2 KV cache page size must be 52096 bytes");
+    TORCH_CHECK(byte_v2_kv_cache.is_contiguous(),
+                "ByteV2 KV cache must be contiguous");
+    TORCH_CHECK(byte_v2_kv_cache.size(0) <=
+                    std::numeric_limits<int>::max(),
+                "ByteV2 KV cache has too many pages");
+    if (byte_v2_raw_staging != nullptr) {
+        TORCH_CHECK(byte_v2_raw_staging->is_cuda(),
+                    "ByteV2 raw staging must be on CUDA");
+        TORCH_CHECK(byte_v2_page_to_raw_slot->is_cuda(),
+                    "ByteV2 page-to-raw-slot map must be on CUDA");
+        TORCH_CHECK(byte_v2_raw_staging->device() == q.device() &&
+                        byte_v2_page_to_raw_slot->device() == q.device(),
+                    "ByteV2 raw staging, page map, and query must be on the same device");
+        TORCH_CHECK(byte_v2_raw_staging->dtype() == torch::kUInt8,
+                    "ByteV2 raw staging must have dtype uint8");
+        TORCH_CHECK(byte_v2_raw_staging->dim() == 2 &&
+                        byte_v2_raw_staging->size(1) ==
+                            kByteV2RawSlotSizeBytes,
+                    "ByteV2 raw staging must have shape (num_slots, 65536)");
+        TORCH_CHECK(byte_v2_raw_staging->size(0) > 0 &&
+                        byte_v2_raw_staging->size(0) <=
+                            std::numeric_limits<int>::max(),
+                    "ByteV2 raw staging slot count is invalid");
+        TORCH_CHECK(byte_v2_raw_staging->is_contiguous(),
+                    "ByteV2 raw staging must be contiguous");
+        TORCH_CHECK(byte_v2_page_to_raw_slot->dtype() == torch::kInt32,
+                    "ByteV2 page-to-raw-slot map must have dtype int32");
+        TORCH_CHECK(byte_v2_page_to_raw_slot->dim() == 1 &&
+                        byte_v2_page_to_raw_slot->size(0) ==
+                            byte_v2_kv_cache.size(0),
+                    "ByteV2 page-to-raw-slot map must have shape (num_pages,)");
+        TORCH_CHECK(byte_v2_page_to_raw_slot->is_contiguous(),
+                    "ByteV2 page-to-raw-slot map must be contiguous");
+    }
+    TORCH_CHECK(block_table_.has_value(),
+                "ByteV2 FA2 requires a paged KV block table");
+    const at::Tensor &byte_v2_block_table = block_table_.value();
+    TORCH_CHECK(byte_v2_block_table.dim() == 2,
+                "ByteV2 FA2 block table must be rank 2");
+    TORCH_CHECK(
+        max_seqlen_k >= 0 &&
+            static_cast<int64_t>(max_seqlen_k) <=
+                byte_v2_block_table.size(1) * kByteV2PageBlockSize,
+        "ByteV2 FA2 max sequence length exceeds block-table capacity");
+    TORCH_CHECK(p_dropout == 0.0f,
+                "ByteV2 FA2 does not support dropout");
+    TORCH_CHECK(!return_softmax,
+                "ByteV2 FA2 does not return the attention probability matrix");
+
+    const at::Tensor *byte_v2_page_unsafe_flags = nullptr;
+    if (byte_v2_page_unsafe_flags_.has_value()) {
+        const at::Tensor &flags = byte_v2_page_unsafe_flags_.value();
+        CHECK_DEVICE(flags);
+        TORCH_CHECK(flags.device() == q.device(),
+                    "ByteV2 page unsafe flags and query must be on the same device");
+        TORCH_CHECK(flags.dtype() == torch::kInt32,
+                    "ByteV2 page unsafe flags must have dtype int32");
+        TORCH_CHECK(flags.dim() == 1 &&
+                        flags.size(0) == byte_v2_kv_cache.size(0),
+                    "ByteV2 page unsafe flags must have shape (num_pages,)");
+        TORCH_CHECK(flags.is_contiguous(),
+                    "ByteV2 page unsafe flags must be contiguous");
+        byte_v2_page_unsafe_flags = &flags;
+    }
+
+    // The shared host setup expects separate rank-4 BF16 K/V tensors. The
+    // ByteV2 kernel ignores their pointers and strides, so a zero-stride view
+    // backed by the first query row provides the expected logical shape
+    // without allocating or materializing a raw cache.
+    at::Tensor fake_kv = q.as_strided(
+        {byte_v2_kv_cache.size(0), kByteV2PageBlockSize,
+         kByteV2NumKvHeads, kByteV2HeadDim},
+        {0, 0, 0, 1});
+
+    return mha_varlen_fwd_impl(
+        q, fake_kv, fake_kv, out_, cu_seqlens_q, cu_seqlens_k, seqused_k,
+        leftpad_k_, block_table_, alibi_slopes_, max_seqlen_q, max_seqlen_k,
+        p_dropout, softmax_scale, zero_tensors, is_causal, window_size_left,
+        window_size_right, softcap, return_softmax, num_splits, gen_,
+        &byte_v2_kv_cache, byte_v2_page_unsafe_flags,
+        byte_v2_raw_staging, byte_v2_page_to_raw_slot,
+        /*is_byte_v2_call=*/true);
+}
